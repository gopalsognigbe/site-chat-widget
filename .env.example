# Copy to .env and fill in. Never commit .env.

# --- LLM: any OpenAI-compatible API ---
# Option A — Groq, free plan (https://console.groq.com/keys).
# Free models: openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b
# (limits: 30 requests/min, 1,000/day, 8,000 tokens/min).
# GROQ_API_KEY and OPENAI_API_KEY are interchangeable; with a gsk_ key the
# base URL defaults to Groq.
GROQ_API_KEY=gsk_your_groq_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# Only for reasoning models such as gpt-oss ("low" keeps answers fast).
# Leave empty for regular models like Llama.
LLM_REASONING_EFFORT=low

# Option B — Hugging Face Inference Providers (needs credits or PRO).
# Despite the name, OPENAI_API_KEY then holds your Hugging Face token (hf_...),
# created at https://huggingface.co/settings/tokens with "Make calls to
# Inference Providers".
# OPENAI_API_KEY=hf_your_token_here
# OPENAI_BASE_URL=https://router.huggingface.co/v1
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# LLM_REASONING_EFFORT=

# --- Embeddings ---
# "local": sentence-transformers on your machine, free, no API calls.
# "openai": embeddings via OPENAI_BASE_URL (EMBEDDING_MODEL then defaults
#           to text-embedding-3-small).
EMBEDDING_PROVIDER=local
# Leave empty to use the provider's default.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Storage / crawl ---
CHROMA_DIR=./data/chroma
MAX_PAGES=50

# --- Image generation (optional, tools/kie_image.sh) ---
# Kie.ai key, only needed to regenerate the demo images.
# KIE_API_KEY=your_kie_key_here
